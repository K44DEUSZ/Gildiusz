{
  "name": "@k44deusz/gildiusz",
  "version": "0.1.0",
  "private": true,
  "description": "Polski bot Discord z pokojami, personalizacją profilu, kontrolą formatów plików i zgłoszeniami.",
  "type": "module",
  "engines": {
    "node": ">=24.17.0"
  },
  "scripts": {
    "build": "tsc && node scripts/build-contracts.mjs",
    "build:contracts": "node scripts/build-contracts.mjs",
    "check": "tsc --noEmit && eslint . && prettier --check .",
    "test": "npm run build && node --test test/*.test.mjs",
    "format": "prettier --write .",
    "cli": "node --env-file-if-exists=.env dist/cli.js",
    "start": "node --env-file-if-exists=.env dist/bot/main.js"
  },
  "dependencies": {
    "@js-temporal/polyfill": "0.5.1",
    "@silvia-odwyer/photon-node": "0.3.4",
    "discord.js": "14.28.1",
    "image-size": "2.1.0",
    "proper-lockfile": "4.1.2"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.2",
    "@types/proper-lockfile": "4.1.4",
    "eslint": "10.14.0",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1"
  },
  "overrides": {
    "minimatch": "11.0.1"
  },
  "license": "MIT",
  "author": "Bartosz Golat",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/K44DEUSZ/Gildiusz.git"
  },
  "bugs": {
    "url": "https://github.com/K44DEUSZ/Gildiusz/issues"
  }
}
